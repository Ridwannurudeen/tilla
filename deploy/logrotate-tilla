# Installed on the VPS as /etc/logrotate.d/tilla — a NEW, tilla-only file that cannot
# affect any other project's logs. Covers exactly the two tilla cron logs (the API itself
# logs to journald, which has its own box-wide cap — never touched here).
#
# copytruncate: cron appends with >>, so truncating in place avoids any signal/reopen
# dance. Validate before relying on it:  logrotate -d /etc/logrotate.d/tilla
# Rollback: rm /etc/logrotate.d/tilla
#
# PATH CORRECTED 2026-07-26. This listed /var/log/tilla-backup.log, which has never
# existed: scripts/backup_db.sh is invoked by cron as
#   15 4 * * * cd /opt/tilla && /bin/bash scripts/backup_db.sh >> /opt/tilla/backups/backup.log
# so the real log lives beside the backups. `missingok` meant the mismatch failed
# silently — logrotate happily rotated nothing while the actual log grew forever.
# The offsite path below was always correct.
/opt/tilla/backups/backup.log /var/log/tilla-offsite.log {
    su root root
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
